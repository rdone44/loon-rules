{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clash-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "upload_source_maps": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "PROFILE_NAME": "Clash 网关订阅",
    "CONFIG_URL": "https://raw.githubusercontent.com/rdone44/loon-rules/main/clash/clash-remote.yaml",
    "CONFIG_SINGBOX_URL": "https://raw.githubusercontent.com/rdone44/loon-rules/main/sing-box/config.json",
    "PERSONAL_RULES_URL": "https://raw.githubusercontent.com/rdone44/loon-rules/main/clash/personal-direct.list",
    "PUBLIC_BASE": "https://sub.opcf.us.ci",
    "CACHE_TTL": "300",
    "NODE_TTL": "1800",
    "PROVIDER_INTERVAL": "1800"
  },
  "kv_namespaces": [
    {
      "binding": "PROFILES",
      "id": "0c3851a9658c4a07b55562c7abd06f28"
    }
  ]
}
